# Export these values in your shell; Rails does not auto-load this file.
# DATABASE_URL=postgresql://localhost/rails_8_avo_development
REDIS_URL=redis://localhost:6379/0
RAILS_MAX_THREADS=5
SIDEKIQ_CONCURRENCY=5
APP_HOST=localhost:3000
# APP_STAGE defaults to localhost in development, otherwise RAILS_ENV.
# APP_STAGE=staging
# APP_URL=https://app.example.com
# APP_LOCAL_URL=http://web:3000
# APP_PUBLIC_URL=https://app.example.com
MAIL_FROM=no-reply@example.com
ALLOW_PUBLIC_REGISTRATION=false
# ADMIN_PASSWORD is required for the initial production seed. Do not commit its value.
# Optional temporary development tunnel (hostname only, without https://).
# PUBLIC_PREVIEW_HOST=your-assigned-host.trycloudflare.com
# Production also requires RAILS_MASTER_KEY and an SMTP server.
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
